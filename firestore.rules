// Firestore Security Rules
// Apply via: Firebase Console → Firestore Database → Rules
// Or via: firebase deploy --only firestore:rules

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Per-user data — only the authenticated owner can read/write
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Shared price data written by Firebase Admin SDK (agents) — any auth'd user can read
    match /prices/{document=**} {
      allow read:  if request.auth != null;
      allow write: if false;
    }

  }
}
